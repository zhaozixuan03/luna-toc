{
    "manifest_version": 3,
    "name": "LunaTOC Remix - ChatGPT Navigator",
    "short_name": "LunaTOC Remix",
    "version": "1.11.4",
    "description": "Navigate long ChatGPT conversations with a searchable table of contents and privacy-first Smart Labels.",
    "icons": {
        "16": "src/icons/icon16.png",
        "32": "src/icons/icon32.png",
        "48": "src/icons/icon48.png",
        "128": "src/icons/icon128.png"
    },
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "src/icons/icon16.png",
            "32": "src/icons/icon32.png",
            "48": "src/icons/icon48.png"
        }
    },
    "options_ui": {
        "page": "src/options/options.html",
        "open_in_tab": true
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://copilot.microsoft.com/*"
            ],
            "js": [
                "src/pageHook/pageHook.iife.ts"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://copilot.microsoft.com/*"
            ],
            "js": [
                "src/content.ts"
            ],
            "css": [
                "src/styles/content.css"
            ],
            "run_at": "document_start",
            "world": "ISOLATED"
        }
    ],
    "version_name": "1.11.4-d11"
}
